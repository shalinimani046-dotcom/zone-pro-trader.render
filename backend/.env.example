# ---------- Server ----------
PORT=8000
NODE_ENV=development
# Only needed if the website is hosted on a DIFFERENT domain than this server. Usually leave empty.
CORS_ORIGINS=

# ---------- Admin (REQUIRED) ----------
# Your Google email(s). These people can open pages/admin-users.html and add/remove users.
# Comma-separated, e.g. you@gmail.com,partner@gmail.com
ADMIN_EMAILS=

# ---------- Firebase Admin (REQUIRED) ----------
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Convert the downloaded JSON to one line of base64:
#   Linux/Mac:  base64 -w0 serviceAccountKey.json
#   Windows PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------- Payments (PARKED - leave as false for now) ----------
# Set to true later to bring back plans, Razorpay checkout and the webhook.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
